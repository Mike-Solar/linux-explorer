#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Control Panel
Name[zh_CN]=控制面板
Comment=Adjust your computer's settings
Comment[zh_CN]=调整计算机的设置
Exec=explorer --control-panel
Icon=preferences-system
Terminal=false
Type=Application
Categories=Qt;KDE;Settings;
Keywords=control panel;settings;system;programs;uninstall;
StartupNotify=true